{% extends 'base.html.twig' %}

{% block title %}Hello IdentificationController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<title>title</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

<div class="example-wrapper">
    <div>
        <section id='Espace-professeur' class='text-end'>
            <form method='POST' action=''>
                <button type="submit" class="btn btn-primary">Espace professeur</button>
            </form>
        </section>
        <section id='Espace-eleve'>
            <div id='présentation' class="card">
                <h2 class="card-header">Présentation</h2>
                <div class="card-body">
                    <h5 class="card-title"> titre de la présentation</h5>
                    <p class="card-text">text de présentation</p>
                </div>
            </div>
            <form id='identification-eleve' method='POST' class='text-center'>
                <input type='text' name='code-identification' placeholder='code'/>
                <button type="submit" class="btn btn-primary">Rejoindre</button>
            </form>
        </section>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
        
{% endblock %}